# Used by `pnpm deploy:arbitrum-sepolia` / `pnpm deploy:polygon-amoy`.
# The local chain (`pnpm deploy:local`) needs none of this: it uses Anvil's development accounts.

# Wallet that pays for the deployment. Use a fresh testnet-only key and never commit .env.
DEPLOYER_PRIVATE_KEY=

# Role holders. Each defaults to the deployer when left empty.
# ADMIN_ADDRESS should be a Safe multisig on any shared network.
ADMIN_ADDRESS=
OFFICER_ADDRESS=
OPERATOR_ADDRESS=
VALUATOR_ADDRESS=
TREASURY_ADDRESS=
# Wallet the API uses to write the identity registry (its key goes in apps/api/.env)
REGISTRAR_ADDRESS=

# Existing stablecoin. Leave empty to deploy MockUSDC.
SETTLEMENT_TOKEN=

# Optional: verify contracts on the block explorer (Etherscan API v2 key)
ETHERSCAN_API_KEY=
