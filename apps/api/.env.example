# Every value has a local default when NODE_ENV is not "production".
PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgres://rwa:rwa@localhost:5433/rwa
INDEXER_SCHEMA=indexer
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# 32+ random characters
JWT_SECRET=
JWT_TTL=8h
# 64 hex characters (32 bytes) used for AES-256-GCM on personal data
PII_ENCRYPTION_KEY=
# Wallet holding REGISTRAR_ROLE on the IdentityRegistry. On local Anvil this defaults to account #5.
REGISTRAR_PRIVATE_KEY=
KYC_VALIDITY_DAYS=365
