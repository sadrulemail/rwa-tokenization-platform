# All values have local defaults (Anvil on 8545, API on 4000).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Optional: enables WalletConnect / mobile wallets (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Show the Anvil development accounts in the wallet list (local chain only)
NEXT_PUBLIC_LOCAL_WALLETS=true
